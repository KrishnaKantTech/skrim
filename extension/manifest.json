{
  "manifest_version": 3,
  "name": "Skrim",
  "version": "0.3.0",
  "description": "Hides your bookmarks bar automatically while you share your screen.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/skrim-16.png",
    "32": "icons/skrim-32.png",
    "48": "icons/skrim-48.png",
    "128": "icons/skrim-128.png"
  },
  "permissions": ["bookmarks", "storage", "alarms", "tabs"],
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED",
      "js": ["src/bridge.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/hook.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Skrim",
    "default_icon": {
      "16": "icons/state-armed-16.png",
      "32": "icons/state-armed-32.png"
    }
  }
}
